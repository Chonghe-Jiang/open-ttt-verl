+    def expand_packed_lora(
+        self,
+        lora_a: list[torch.Tensor],
+        lora_b: list[torch.Tensor],
+    ) -> tuple[list[torch.Tensor], list[torch.Tensor]]:
+        """Expand logical adapter groups to the fused layer's output slices.
+
+        Qwen3.5 stores ``in_proj_qkv`` as one adapter spanning Q+K+V and
+        ``in_proj_z`` as another adapter, while vLLM executes them as a
+        four-slice ``in_proj_qkvz`` layer.  Split B by output rows and reuse A
+        for every physical slice covered by a logical adapter.
+        """
+        expanded_a: list[torch.Tensor] = []
+        expanded_b: list[torch.Tensor] = []
+        start_idx = 0
+        for a_i, b_i in zip(lora_a, lora_b):
+            b_rows, cumulative_rows, covered = b_i.shape[0], 0, 0
+            for i in range(start_idx, self.n_slices):
+                cumulative_rows += self.output_sizes[i]
+                if cumulative_rows == b_rows:
+                    covered = i - start_idx + 1
+                    break
+            else:
+                raise ValueError(
+                    f"Cannot split LoRA B with {b_rows} rows into "
+                    f"{self.n_slices} slices with output sizes "
+                    f"{self.output_sizes} starting at {start_idx}."
+                )
+
+            start = 0
+            for j in range(covered):
+                size = self.output_sizes[start_idx + j]
+                expanded_b.append(b_i[start : start + size, :])
+                expanded_a.append(a_i)
+                start += size
+            start_idx += covered
+        return expanded_a, expanded_b
+
